{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "bash scripts/build.sh",
  "outputDirectory": "brain-warmup/dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/g/:game", "destination": "/shell.html" },
    { "source": "/g/:game/play", "destination": "/shell.html" },
    { "source": "/g/:game/result", "destination": "/shell.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
